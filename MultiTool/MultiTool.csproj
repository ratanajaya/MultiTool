<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MultiTool.ico</ApplicationIcon>
    <AssemblyName>MultiTool</AssemblyName>
    <RootNamespace>MultiTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MultiTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MultiTool.Tests" />
  </ItemGroup>
</Project>
