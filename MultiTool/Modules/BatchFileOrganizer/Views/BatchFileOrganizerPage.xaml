<UserControl x:Class="MultiTool.Modules.BatchFileOrganizer.Views.BatchFileOrganizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:MultiTool.Presentation.ViewModels"
             AllowDrop="True"
             PreviewDragOver="HandleFolderDragOver"
             PreviewDrop="HandleFolderDrop">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Batch file organizer" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Arrange files visually, then rename them in that exact order."
                   Foreground="#4B5563"
                   Margin="0,5,0,0" />
      </StackPanel>
      <Button DockPanel.Dock="Right"
              Content="Browse folder"
              Command="{Binding BrowseCommand}"
              HorizontalAlignment="Right"
              VerticalAlignment="Top" />
    </DockPanel>

    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="2"
            CornerRadius="12"
            Padding="34">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasFolder}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <TextBlock Text="Drop one folder here"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Only files directly inside the folder will be loaded. Subfolders are left untouched."
                   Foreground="#64748B"
                   Margin="0,8,0,18"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Content="Browse folder"
                Command="{Binding BrowseCommand}"
                HorizontalAlignment="Center"
                Background="{StaticResource AccentBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                Foreground="White" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasFolder}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="390" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="6*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Padding="18" Background="White" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Files" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding FolderPath}"
                         Foreground="#64748B"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding FolderPath}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding FileCountText}"
                       Foreground="#475569"
                       VerticalAlignment="Center"
                       Margin="12,0" />
            <Button Grid.Column="2"
                    Content="Reload"
                    Command="{Binding ReloadCommand}"
                    MinWidth="72"
                    Margin="0" />
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Prefix" FontWeight="SemiBold" />
              <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Text="Start" FontWeight="SemiBold" />
              <TextBox Text="{Binding StartNumberText, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Digits" FontWeight="SemiBold" />
              <TextBox Text="{Binding PaddingText, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,0" />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Row="2"
                     Text="{Binding ValidationMessage}"
                     Foreground="#B91C1C"
                     FontSize="12"
                     TextWrapping="Wrap"
                     MinHeight="18"
                     Margin="0,0,0,5" />

          <ListBox x:Name="FileList"
                   Grid.Row="3"
                   ItemsSource="{Binding Files}"
                   SelectedItem="{Binding SelectedFile}"
                   IsEnabled="{Binding CanEdit}"
                   BorderBrush="#CBD5E1"
                   BorderThickness="1"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   PreviewMouseLeftButtonDown="HandleFileMouseDown"
                   PreviewMouseMove="HandleFileMouseMove"
                   DragOver="HandleFileDragOver"
                   DragLeave="HandleFileDragLeave"
                   Drop="HandleFileDrop">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="RowBorder"
                        Padding="8,7"
                        BorderBrush="#2563EB"
                        BorderThickness="0"
                        Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Position}"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentName}"
                               ToolTip="{Binding CurrentName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="→"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding ProposedName}"
                               ToolTip="{Binding ProposedName}"
                               Foreground="#1D4ED8"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding DropPosition}"
                               Value="{x:Static viewModels:FileDropPosition.Before}">
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,3,0,0" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DropPosition}"
                               Value="{x:Static viewModels:FileDropPosition.After}">
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,0,0,3" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Drag rows to change numbering order."
                       Foreground="#64748B"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Rename files"
                    Command="{Binding RenameCommand}"
                    Margin="8,0,0,0"
                    Background="{StaticResource AccentBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    Foreground="White" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Padding="18" Background="#111827" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="{Binding SelectedFile.CurrentName, TargetNullValue=Preview}"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,0,12" />
          <Grid Grid.Row="1" Background="#0B1220">
            <Image Source="{Binding PreviewSource}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
            <TextBlock Text="{Binding PreviewMessage}"
                       Foreground="#CBD5E1"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="360"
                       Margin="24">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPreview}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         VerticalAlignment="Top">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding Status}"
               Foreground="#475569"
               TextWrapping="Wrap"
               Margin="2,12,2,0" />
  </Grid>
</UserControl>
