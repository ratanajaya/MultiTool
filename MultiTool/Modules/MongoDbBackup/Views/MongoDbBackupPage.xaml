<UserControl x:Class="MultiTool.Modules.MongoDbBackup.Views.MongoDbBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="HandleLoaded"
             Unloaded="HandleUnloaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <DockPanel Margin="0,0,0,22">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="MongoDB deployment backup" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Create a compressed archive of every database visible to the supplied account."
                     Foreground="#4B5563" Margin="0,5,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right"
                Background="#E5E7EB"
                CornerRadius="12"
                Padding="12,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
        </Border>
      </DockPanel>

      <Border Padding="24" Background="White" CornerRadius="10">
        <StackPanel>
          <TextBlock Text="MongoDB Database Tool" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Select mongodump 100.3.0 or newer. The validated path is remembered."
                     Foreground="#6B7280" Margin="0,4,0,14" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsInputEnabled}" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseToolCommand}" />
            <Button Grid.Column="2" Content="Validate" Command="{Binding ValidateToolCommand}" />
          </Grid>
          <TextBlock Text="{Binding ToolVersion, StringFormat=Validated version: {0}}"
                     Foreground="#4B5563" Margin="0,2,0,18" />

          <TextBlock Text="Connection string" FontWeight="SemiBold" />
          <PasswordBox x:Name="ConnectionStringBox"
                       Margin="0,4,0,4"
                       IsEnabled="{Binding IsInputEnabled}" />
          <TextBlock Text="Required for every run. MultiTool never stores it in settings, history, logs, or process arguments. Use a deployment URI without a database path."
                     Foreground="#6B7280"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,18" />

          <TextBlock Text="Compressed archive" FontWeight="SemiBold" />
          <Grid Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ArchivePath, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Save as" Command="{Binding BrowseArchiveCommand}" />
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button Content="Back up now"
                    Click="HandleBackupNow"
                    IsEnabled="{Binding CanStartBackup}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderBrush="{StaticResource AccentBrush}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>

          <ProgressBar Height="6"
                       Margin="0,18,0,0"
                       IsIndeterminate="True">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" Padding="18" Background="White" CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Text="Elapsed" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Elapsed}" Foreground="#4B5563" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Activity" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Activity}"
                       Foreground="#4B5563"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,16,0,0" Padding="18" Background="White" CornerRadius="10">
        <StackPanel>
          <TextBlock Text="Latest result this session" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LatestResult}"
                     Foreground="#4B5563"
                     Margin="0,5,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
