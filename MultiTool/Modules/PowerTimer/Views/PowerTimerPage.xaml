<UserControl x:Class="MultiTool.Modules.PowerTimer.Views.PowerTimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <DockPanel Margin="0,0,0,22">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Power timer" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Schedule one shutdown, sleep, or hibernate action."
                     Foreground="#4B5563" Margin="0,5,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right"
                Background="#E5E7EB"
                CornerRadius="12"
                Padding="12,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
        </Border>
      </DockPanel>

      <Border Padding="24" Background="White" CornerRadius="10">
        <StackPanel>
          <TextBlock Text="Power action" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Actions}"
                    SelectedItem="{Binding SelectedAction}"
                    DisplayMemberPath="DisplayName">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>

          <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
            <RadioButton Content="Countdown"
                         GroupName="ScheduleMode"
                         IsChecked="{Binding UseCountdown}"
                         Margin="0,0,24,0" />
            <RadioButton Content="Exact local time"
                         GroupName="ScheduleMode"
                         IsChecked="{Binding UseExactTime}" />
          </StackPanel>

          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseCountdown}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Hours" FontWeight="SemiBold" />
                <TextBox Text="{Binding CountdownHours, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Minutes" FontWeight="SemiBold" />
                <TextBox Text="{Binding CountdownMinutes, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseCountdown}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Date" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding ExactDate}" Margin="0,4,0,12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Hour" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding ExactHour}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Minute" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding ExactMinute}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <TextBlock Text="A Windows notification appears one minute before the action. Open this page to cancel the timer."
                     Foreground="#6B7280"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,18" />

          <StackPanel Orientation="Horizontal">
            <Button Content="{Binding ScheduleButtonLabel}"
                    Command="{Binding ScheduleCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderBrush="{StaticResource AccentBrush}" />
            <Button Content="Cancel timer" Command="{Binding CancelCommand}" />
            <Button Content="Run now" Command="{Binding RunNowCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" Padding="18" Background="White" CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Text="Action" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentAction}" Foreground="#4B5563" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,28,0">
            <TextBlock Text="Target" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TargetTime}" Foreground="#4B5563" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,28,0">
            <TextBlock Text="Remaining" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Remaining}" Foreground="#4B5563" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="Activity" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Message}"
                       Foreground="#4B5563"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
