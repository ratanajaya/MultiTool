<UserControl x:Class="MultiTool.Presentation.Views.PlaceholderModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 FontSize="26"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description, ElementName=Root}"
                 Foreground="#4B5563"
                 Margin="0,5,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,22,0,0"
            Padding="36"
            Background="White"
            CornerRadius="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="54" Height="54" Background="#EFF6FF" CornerRadius="27">
          <TextBlock Text="…"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="28"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,-6,0,0" />
        </Border>
        <TextBlock Text="Coming soon"
                   Margin="0,18,0,0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="This module is planned but has not been implemented yet."
                   Margin="0,7,0,0"
                   Foreground="#6B7280"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
