<Window x:Class="MultiTool.Presentation.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:audioViews="clr-namespace:MultiTool.Modules.AudioOutputKeepAlive.Views"
        xmlns:viewModels="clr-namespace:MultiTool.Presentation.ViewModels"
        xmlns:views="clr-namespace:MultiTool.Presentation.Views"
        Title="MultiTool"
        Width="1040"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="0,0,1,0">
      <Grid Margin="16,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MODULES"
                   Margin="12,0,0,12"
                   Foreground="#9CA3AF"
                   FontSize="11"
                   FontWeight="SemiBold" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="SelectionBorder"
                            Padding="12,11"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="SelectionBorder" Property="Background" Value="#1F2937" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="SelectionBorder" Property="Background" Value="#2563EB" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Availability}"
                           Margin="0,3,0,0"
                           Foreground="#D1D5DB"
                           FontSize="11" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}"
                           Value="{x:Static viewModels:ModulePage.AudioOutputKeepAlive}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <audioViews:AudioOutputKeepAlivePage />
      </Grid>

      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}"
                           Value="{x:Static viewModels:ModulePage.MicrophoneKeepAwake}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <views:PlaceholderModulePage
            Title="Microphone keep-awake"
            Description="Continuously keeps the selected microphone active to prevent device power saving." />
      </Grid>

      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}"
                           Value="{x:Static viewModels:ModulePage.PowerTimer}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <views:PlaceholderModulePage
            Title="Power timer"
            Description="Schedule shutdown, sleep, or hibernate actions with a warning and cancellation period." />
      </Grid>

      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}"
                           Value="{x:Static viewModels:ModulePage.UsageReminders}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <views:PlaceholderModulePage
            Title="Usage reminders"
            Description="Configure gentle wrap-up and sign-off reminders for designated times." />
      </Grid>

      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}"
                           Value="{x:Static viewModels:ModulePage.MongoDbBackup}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <views:PlaceholderModulePage
            Title="MongoDB backup"
            Description="Create compressed MongoDB backup archives from a configured connection." />
      </Grid>
    </Grid>
  </Grid>
</Window>
